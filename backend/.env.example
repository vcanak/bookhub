# =============================================================================
# FastAPI Starter — environment configuration
# =============================================================================
# Copy this file to `.env` and adjust as needed:
#
#     cp .env.example .env
#
# Every variable below maps 1:1 to a field in app/core/config.py. Variable names
# are CASE-SENSITIVE. Unset variables fall back to the defaults shown here.
#
# The defaults target the Docker Compose stack, where POSTGRES_SERVER and
# REDIS_HOST resolve to the Compose service names ("postgres" / "redis").
# For bare-metal local development (running the app directly on your machine),
# set POSTGRES_SERVER=localhost and REDIS_HOST=localhost instead.
# =============================================================================

# --- Application -------------------------------------------------------------
PROJECT_NAME="BookHub API"
VERSION="0.1.0"
DESCRIPTION="Book-oriented social media API."
API_V1_PREFIX="/api/v1"
# One of: local | development | staging | production | test
ENVIRONMENT="local"
DEBUG="false"

# --- Logging -----------------------------------------------------------------
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL="INFO"
# Emit logs as JSON (true) for production pipelines, or console-friendly (false).
LOG_JSON="true"

# --- Security / JWT ----------------------------------------------------------
# SECRET_KEY must be at least 32 characters. The app REFUSES to start in
# production while this insecure default is in place. Generate a strong value:
#     python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY="CHANGE_ME_insecure_dev_secret_key_minimum_32_chars_long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# --- Uploads -------------------------------------------------------------------
# Directory where uploaded images are stored (served at GET /uploads/*).
UPLOAD_DIR="uploads"

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed origins, e.g.
#   BACKEND_CORS_ORIGINS="http://localhost:3000,https://app.example.com"
# Leave empty to disable CORS. Defaults cover Expo web (8081/19006) and CRA/Vite.
BACKEND_CORS_ORIGINS="http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:5173"

# --- Database (PostgreSQL) ---------------------------------------------------
# Use "postgres" for the Compose stack, "localhost" for bare-metal local dev.
POSTGRES_SERVER="postgres"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="app"
# Connection pool tuning.
DB_POOL_SIZE="10"
DB_MAX_OVERFLOW="20"
DB_POOL_PRE_PING="true"
# Echo SQL statements to the logs (verbose; for debugging only).
DB_ECHO="false"

# --- Redis -------------------------------------------------------------------
# Use "redis" for the Compose stack, "localhost" for bare-metal local dev.
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_DB="0"
# Optional Redis password (leave empty for no auth).
REDIS_PASSWORD=""

# --- Celery (background jobs) ------------------------------------------------
# If left empty, the broker/result backend are derived from the Redis settings
# above (redis://[:PASSWORD@]REDIS_HOST:REDIS_PORT/REDIS_DB). Set explicitly to
# override.
CELERY_BROKER_URL=""
CELERY_RESULT_BACKEND=""

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_ENABLED="true"
# Default limit applied globally (slowapi syntax), e.g. "200/minute".
RATE_LIMIT_DEFAULT="200/minute"

# --- Observability -----------------------------------------------------------
# Expose Prometheus metrics at GET /metrics.
METRICS_ENABLED="true"

# --- Bootstrap superuser (optional) ------------------------------------------
# If set, used to seed an initial superuser account. Leave empty to skip.
FIRST_SUPERUSER_EMAIL=""
FIRST_SUPERUSER_PASSWORD=""
